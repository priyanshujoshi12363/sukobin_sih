<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="180dp">

            <View
                android:id="@+id/ringOuter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:background="@drawable/ring_officer_outer" />

            <View
                android:id="@+id/ringInner"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/ring_officer_inner" />

            <FrameLayout
                android:id="@+id/logoHolder"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/bg_logo_officer">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_map"
                    app:tint="@color/officer_navy" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/brandName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:alpha="0"
            android:letterSpacing="0.02"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/brandTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0"
            android:text="@string/splash_tagline"
            android:textColor="@color/officer_sky"
            android:textSize="13sp" />

        <FrameLayout
            android:id="@+id/progressTrack"
            android:layout_width="150dp"
            android:layout_height="3dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/splash_track_officer"
            android:clipChildren="true">

            <View
                android:id="@+id/progressSweep"
                android:layout_width="52dp"
                android:layout_height="match_parent"
                android:background="@drawable/splash_sweep_officer" />
        </FrameLayout>

        <TextView
            android:id="@+id/statusLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/splash_status_verify"
            android:textColor="#6C8CA6"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
