<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/methodRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_sm"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="13dp">

    <FrameLayout
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_circle_mint">

        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="center"
            android:contentDescription="@string/demo_pay_choose"
            android:src="@drawable/ic_wallet"
            app:tint="#0C831F" />
    </FrameLayout>

    <TextView
        android:id="@+id/methodName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:textColor="@color/gray_800"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/methodCheck"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@string/demo_pay_confirm"
        android:src="@drawable/ic_check_circle"
        android:visibility="invisible"
        app:tint="#0C831F" />
</LinearLayout>
