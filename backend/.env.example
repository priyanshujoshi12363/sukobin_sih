PORT=8000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sukobin?retryWrites=true&w=majority

JWT_SECRET=<long random string>
JWT_TIME=1300d

# Firebase admin, for FCM push to the native apps.
# serviceAccountKey.json is gitignored, so a deployed server MUST use this
# instead: the whole service-account JSON, either raw or base64 encoded.
# Without it the server still boots but silently skips every push.
FIREBASE_SERVICE_ACCOUNT=<base64 of serviceAccountKey.json>

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

GOOGLE_API_KEY=

# Incident classification of free-text field reports.
# Optional: without it the deterministic keyword classifier is used instead.
OLLAMA_API_KEY=
OLLAMA_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_MODEL_FAST=gpt-oss:20b

# Road routing. The public demo server is rate limited; run your own for load.
OSRM_URL=https://router.project-osrm.org

# DEMO ONLY. Completes checkout without a payment gateway, for exhibition
# builds shown before a gateway account is live. Orders it settles are stored
# with paymentMethod DEMO and a demoReference so demo money is never confused
# with real money. Leave false in real deployments.
DEMO_PAYMENT=false

# DEMO ONLY. Returns the OTP in the API response because no SMS provider is
# wired yet. Anyone who can call the API can then sign in as any phone number.
# Leave unset in real deployments and integrate MSG91/Twilio in sendOtp instead.
ALLOW_DEV_OTP=false

# Matching and sensing tuning (safe defaults if unset)
MATCH_CORRIDOR_KM=10
PROBE_WINDOW_MIN=45
PROBE_MIN_VEHICLES=2
ROUTE_CORRIDOR_KM=2.5
